module(
    name = "bazel-docker-containerization",
    version = "0.1.0",
)

bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "llvm", version = "0.8.17")

http_archive = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:http.bzl",
    "http_archive",
)

http_archive(
    name = "mold_prebuilt",
    urls = [
        "https://github.com/rui314/mold/releases/download/v2.42.0/mold-2.42.0-x86_64-linux.tar.gz",
    ],
    sha256 = "f5ed2f6e31d1ada4f07fe766fe0de7a73104d1c5cdc59086fcecc16a43720b6d",
    strip_prefix = "mold-2.42.0-x86_64-linux",
    build_file = "//bazel/overlays/mold:mold.BUILD",
)

register_toolchains(
    "//toolchains:gcc12",
    "//toolchains:gcc14",
    "//toolchains:clang21",
    "//toolchains:clang22",
    "@llvm//toolchain:all",
)
